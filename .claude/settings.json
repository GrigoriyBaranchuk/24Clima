{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "export PATH=\"/opt/homebrew/bin:$PATH\"; uv run --directory \"$HOME/Projects/claude-memory-compiler\" python \"$HOME/Projects/claude-memory-compiler/hooks/session-start.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "export PATH=\"/opt/homebrew/bin:$PATH\"; uv run --directory \"$HOME/Projects/claude-memory-compiler\" python \"$HOME/Projects/claude-memory-compiler/hooks/pre-compact.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "export PATH=\"/opt/homebrew/bin:$PATH\"; uv run --directory \"$HOME/Projects/claude-memory-compiler\" python \"$HOME/Projects/claude-memory-compiler/hooks/session-end.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
